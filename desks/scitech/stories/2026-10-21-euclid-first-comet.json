{
 "id": "2026-10-21-euclid-first-comet",
 "lang": "en",
 "script": [
  {
   "id": "hook",
   "text": "A dark energy telescope just found a comet nobody had seen. How?"
  },
  {
   "id": "f1",
   "text": "The European Space Agency says its Euclid telescope caught a new comet in images taken between September sixteenth and twenty fourth. A researcher's software flagged a moving dot. Checks against catalogues of known comets and asteroids found no match."
  },
  {
   "id": "f2",
   "text": "The Minor Planet Center confirmed it as a comet on October eighth. It is named C twenty twenty six S one, Euclid. It is faint, about one point three billion kilometres from Earth, and ESA says its orbit takes thousands of years."
  },
  {
   "id": "f3",
   "text": "Euclid was built to map billions of galaxies, so this is its first comet. ESA says this one is not a target for its Comet Interceptor mission. But quick detections like it could help find future targets, ESA scientists say."
  },
  {
   "id": "cta",
   "text": "Will Euclid find more comets? Yes or no?"
  }
 ],
