 "script": [
  {
   "id": "hook",
   "text": "Typhoon In-fa is tearing through the Northern Marianas. How bad will it get?"
  },
  {
   "id": "f1",
   "text": "The National Weather Service in Guam issued typhoon warnings for Agrihan, Pagan and Alamagan, three remote Northern Mariana islands. For Agrihan, it warned of destructive winds of one hundred twenty to one hundred forty-five miles an hour near the eyewall."
  },
  {
   "id": "f2",
   "text": "Marianas Variety reported In-fa was forecast to pass over or just north of Agrihan on Friday evening as a category four. Local reports citing the weather service put sustained winds near one hundred forty-five miles an hour."
  },
  {
   "id": "f3",
   "text": "Guam, Saipan, Tinian and Rota sit outside the forecast cone, the weather service says. Japan's weather agency expects In-fa near the Ogasawara Islands around Sunday. AccuWeather calls it the fifth typhoon to affect the Marianas this year."
  },
  {
   "id": "cta",
   "text": "Will In-fa weaken before it nears Japan? Yes or no?"
  }
 ],
