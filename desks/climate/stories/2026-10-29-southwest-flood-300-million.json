 "script": [
  {
   "id": "hook",
   "text": "New Mexico's floods may cost three hundred million dollars. Is more rain coming?"
  },
  {
   "id": "f1",
   "text": "New Mexico's governor estimates recovery from the floods could cost up to three hundred million dollars, NPR reports. The Associated Press says federal disaster aid has been announced, with the state covering twenty-five percent of eligible costs."
  },
  {
   "id": "f2",
   "text": "San Juan County officials say rescuers pulled between two hundred and three hundred people to safety. Colorado's governor declared a disaster emergency in eleven counties. The town of Bluff, Utah, was partly underwater, and the Associated Press reports one death."
  },
  {
   "id": "f3",
   "text": "NBC News says flooding damaged wastewater facilities on the Navajo Nation near Shiprock, sending sewage into the San Juan River. Weather dot com reports more rain and mountain snow from Saturday into Monday, on saturated ground."
  },
  {
   "id": "cta",
   "text": "Will the Southwest see new flooding this weekend? Yes or no?"
  }
 ],
